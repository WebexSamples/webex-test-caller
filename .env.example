# Copy this file to .env and fill in the OAuth values locally.
# .env is ignored by Git and should be chmod 600.
WEBEX_TEST_CALLER_CLIENT_ID=
WEBEX_TEST_CALLER_CLIENT_SECRET=
WEBEX_TEST_CALLER_REDIRECT_URI=http://localhost:8765/oauth/callback
WEBEX_TEST_CALLER_TEST_USER_EMAIL=your-dedicated-calling-user@example.com
# Optional: override the shared user-level OAuth token location.
# WEBEX_TEST_CALLER_TOKEN_PATH=/absolute/path/to/oauth-token.json
# Optional: a temporary access token for a single run (not saved).
# WEBEX_TEST_CALLER_ACCESS_TOKEN=
# Optional: a restricted gateway monitoring endpoint for BYOVA assertions.
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_URL=http://127.0.0.1:8080
# Optional: securely forward a private gateway monitoring listener through SSM.
# Keep deployment-specific values in this ignored file, not in a test plan.
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_TARGET=i-0123456789abcdef0
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_HOST=10.0.1.25
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_REGION=us-east-1
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_PROFILE=your-local-aws-profile
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_REMOTE_PORT=8080
# WEBEX_TEST_CALLER_GATEWAY_EVENTS_SSM_LOCAL_PORT=18080
